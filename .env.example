# AI Agent
DEMO_MODE=true  # true = free offline demo; false = use Claude API
ANTHROPIC_API_KEY=your_api_key_here
AGENT_MODEL=claude-sonnet-4-6
PROMPT_VERSION=v2-fewshot

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fake_review_detector

# Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=60

# Confidence-based human review thresholds (0-100)
HIGH_CONFIDENCE_THRESHOLD=80
MEDIUM_CONFIDENCE_THRESHOLD=60

# CORS — comma-separated list of allowed frontend origins in production.
# Leave as "*" for local development only.
ALLOWED_ORIGINS=*

# Batch processing / review length limits
MAX_BATCH_ROWS=100000
MIN_REVIEW_LENGTH=10
MAX_REVIEW_LENGTH=3000
